# Public configuration example only. Never add credentials here.
# Production requires a real HTTPS origin and a proxy that preserves its Host header.
KGLAB_PUBLIC_ORIGIN=https://academy.example.com
# Trust only the exact addresses of your own reverse proxy, if used.
# The trusted proxy MUST overwrite the chosen single-address client header.
# KGLAB_TRUSTED_PROXIES=127.0.0.1,::1
KGLAB_CLIENT_IP_HEADER=x-real-ip
KGLAB_IDENTITIES_PER_HOUR=10
KGLAB_MAX_VOTES=100000
# Node does not automatically load this file; supply environment settings at startup.
